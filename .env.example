# =============================================================
# VW California AI Trip Planner — Environment Variables
# =============================================================
# Copy this file to .env and fill in your real credentials:
#   cp .env.example .env
# =============================================================

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Google Maps Platform
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://user:password@localhost:5432/vw_trip_planner
