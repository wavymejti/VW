# =============================================================
# VW California AI Trip Planner — Environment Variables
# =============================================================
# Copy this file to .env and fill in your real credentials:
#   cp .env.example .env
# =============================================================

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Google Maps Platform
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# PostgreSQL + PostGIS (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:DupaBlada2137%3F@localhost:5432/postgres

# 3D Sniffer (optional)
# HeadTTS server from the AVW repo (<AVW>/tts/start.sh); Flask proxies /tts to it.
HEADTTS_URL=http://127.0.0.1:8882
# Model for Sniffer's short spoken line; defaults to the planner model.
# SNIFFER_LINE_MODEL=gpt-4o-mini

# Google Maps cost switch: lite (default) = only geocoding + directions (routes still work),
# full = also interactive map, Places search/details/photos, Static Maps; off = no Google calls.
GOOGLE_MAPS_MODE=lite
